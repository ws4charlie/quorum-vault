# DEV-ONLY values. This repo is public: never use these PINs/passwords for
# anything real, and never commit a real secret. Copy to .env (gitignored).

# Postgres (docker-compose.yml, host port 55432)
DATABASE_URL=postgres://qv@localhost:55432/quorumvault?sslmode=disable

# PKCS#11 / SoftHSM2. Empty = OS default (macOS /opt/homebrew/lib/softhsm/libsofthsm2.so,
# Linux /usr/lib/softhsm/libsofthsm2.so).
QV_PKCS11_LIB=
# Empty = repo-local ./data/softhsm/softhsm2.conf written by scripts/setup-softhsm.sh.
SOFTHSM2_CONF=
QV_HSM_SO_PIN=so-dev-1234
QV_HSM_PIN=user-dev-1234

# Service
QV_HTTP_ADDR=:8080
QV_DATA_DIR=./data

# Optional: Sepolia RPC for broadcasting (leave empty to only sign + verify locally).
SEPOLIA_RPC_URL=

# Tests: 1 = fail instead of skip when Postgres / SoftHSM are unavailable.
QV_REQUIRE_DB=
QV_REQUIRE_HSM=
