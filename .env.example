# DEV-ONLY values. This repo is public: never use these PINs/passwords for
# anything real, and never commit a real secret. Copy to .env (gitignored).

# Postgres (docker-compose.yml, host port 55432)
DATABASE_URL=postgres://qv@localhost:55432/quorumvault?sslmode=disable

# PKCS#11 / SoftHSM2. Empty = OS default (macOS /opt/homebrew/lib/softhsm/libsofthsm2.so,
# Linux /usr/lib/softhsm/libsofthsm2.so).
QV_PKCS11_LIB=
# Empty = repo-local ./data/softhsm/softhsm2.conf written by scripts/setup-softhsm.sh.
SOFTHSM2_CONF=
QV_HSM_SO_PIN=so-dev-1234
QV_HSM_PIN=user-dev-1234

# Service
QV_HTTP_ADDR=:8080
QV_DATA_DIR=./data

# Optional: Sepolia JSON-RPC node. Fills nonce/fees from the node and
# broadcasts every signed tx (QV_BROADCAST=0: sign only).
#   empty                  = no node: sign + verify locally, nothing broadcast
#   http://127.0.0.1:8545  = local anvil impersonating Sepolia (make chain-up)
#   https://<provider>/... = real Sepolia (needs faucet funds on the wallet address)
SEPOLIA_RPC_URL=
QV_BROADCAST=

# Tests: 1 = fail instead of skip when Postgres / SoftHSM / the local chain are
# unavailable. The e2e tests (make test-e2e) run only against a local anvil
# node with chain ID 11155111 and refuse any other SEPOLIA_RPC_URL.
QV_REQUIRE_DB=
QV_REQUIRE_HSM=
QV_REQUIRE_CHAIN=

# Phase 2 infrastructure (`make infra-up`, compose profile "infra"; all bound to 127.0.0.1).
#   Temporal gRPC  127.0.0.1:7233   (own Postgres "temporal-db", not the business DB)
#   Temporal UI    http://127.0.0.1:8233
#   Redpanda Kafka 127.0.0.1:19092
QV_TEMPORAL_ADDR=127.0.0.1:7233
QV_KAFKA_BROKERS=127.0.0.1:19092
# 1 = the infra smoke test (make test-infra) fails instead of skipping.
QV_REQUIRE_INFRA=

# P3a signing gateway (cmd/qv-gateway). The replay guard must be a DIFFERENT database from the job queue.
#   QV_GATEWAY_JOBS_DSN  business database, connecting as role qv_gateway (SELECT, UPDATE on sign_jobs only;
#                        migration 0004 creates the role NOLOGIN, so an operator grants LOGIN and a password out of band)
#   QV_GATEWAY_GUARD_DSN signing-zone database for the replay guard (schema applied at start)
#   -config <file>       signing-zone trust roots; see internal/gateway/config.example.json
QV_GATEWAY_JOBS_DSN=
QV_GATEWAY_GUARD_DSN=
# Live anvil chain test (internal/gateway): QV_REQUIRE_CHAIN=1 QV_ANVIL_RPC=http://127.0.0.1:18545
QV_ANVIL_RPC=

# P3b closed loop (cmd/qv-core API, cmd/qv-worker workflows).
#   -config <file>  custody config (chain, assets, hot shards, sweep rule, approval tiers); see
#                   internal/custody/config.example.json. The gateway has its OWN config.
#   QV_AUTO_APPROVER_KEY_FILE  file holding the worker's automated approver Ed25519 seed (64 hex
#                   chars); the public key goes into the gateway's config, never the business DB.
#   QV_HTTP_ADDR    qv-core listen address (above)
#   QV_FAILPOINT    TESTS ONLY: "<kind>.<point>" makes qv-worker exit at that boundary
QV_AUTO_APPROVER_KEY_FILE=
# 1 = run the full closed-loop e2e (make test-custody); skipped otherwise.
QV_REQUIRE_CUSTODY=
