     "expr": "histogram_quantile(0.95, sum by (le, op) (rate(qvload_stage_seconds_bucket{stage=\"credited\"}[20s])))",
     "legendFormat": "{{op}} credited",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "qvload-prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le, op) (rate(qvload_stage_seconds_bucket{stage=\"swept\"}[20s])))",
     "legendFormat": "{{op}} swept",
     "refId": "B"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "API requests, p95 by route",
   "description": "What the client sees from each call, including the polls that follow a withdrawal.",
   "datasource": {
    "type": "prometheus",
    "uid": "qvload-prom"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "qvload-prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le, request)(rate(qvload_request_seconds_bucket[20s])))",
     "legendFormat": "{{request}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "CPU per process (percent of one core)",
   "description": "Services are host processes; docker-* are the Postgres, Temporal, Redpanda and anvil containers.",
   "datasource": {
    "type": "prometheus",
    "uid": "qvload-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "qvload-prom"
     },
     "expr": "qvstack_cpu{name!=\"\"}",
     "legendFormat": "{{name}}",
     "refId": "A"
