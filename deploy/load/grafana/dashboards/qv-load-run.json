   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "qvload-prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le, op) (rate(qvload_stage_seconds_bucket{stage=\"approved\"}[20s])))",
     "legendFormat": "{{op}} approved",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "qvload-prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le, op) (rate(qvload_stage_seconds_bucket{stage=\"signing\"}[20s])))",
     "legendFormat": "{{op}} signing",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "qvload-prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le, op) (rate(qvload_stage_seconds_bucket{stage=\"broadcast\"}[20s])))",
     "legendFormat": "{{op}} broadcast",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "qvload-prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le, op) (rate(qvload_stage_seconds_bucket{stage=\"confirmed\"}[20s])))",
     "legendFormat": "{{op}} confirmed",
     "refId": "D"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Deposit stages, p95 since the payment was sent",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "qvload-prom"
