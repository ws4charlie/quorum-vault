{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["clusterKind", "namespaces", "registry"],
  "properties": {
    "clusterKind": { "enum": ["business", "signing-core", "party", "broker"] },
    "environment": { "enum": ["production", "kind"] },
    "namespaces": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" } },
    "registry": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:/-]*[a-z0-9]$" },
    "requireDigest": { "type": "boolean" },
    "pss": {
      "type": "object", "additionalProperties": false,
      "properties": { "level": { "enum": ["restricted"] }, "version": { "type": "string", "pattern": "^v1\\.[0-9]+$" } }
    },
    "enforcement": { "enum": ["Deny", "Warn"] },
    "signature": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["keyless", "key"] },
        "keyless": {
          "type": "object", "additionalProperties": false,
          "properties": { "issuer": { "type": "string", "minLength": 1 }, "subjectRegExp": { "type": "string", "minLength": 1 }, "rekorUrl": { "type": "string" } }
        },
        "key": {
          "type": "object", "additionalProperties": false,
          "properties": { "publicKey": { "type": "string" }, "rekorUrl": { "type": "string" } }
        },
        "webhookTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "configWriters": {
      "type": "object", "additionalProperties": false,
      "properties": { "users": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "groups": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
    },
    "exemptConfigMaps": { "type": "array", "items": { "type": "string" } },
    "serviceAccountTokenAllowed": { "type": "array", "items": { "type": "string" } },
    "breakGlass": {
      "type": "object", "additionalProperties": false,
      "properties": { "group": { "type": "string", "minLength": 1 }, "subjects": { "type": "array", "items": { "type": "object" } } }
    },
    "readers": {
      "type": "object", "additionalProperties": false,
      "properties": { "groups": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
    }
  }
}
